rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function myLinkedStudentId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedStudentId;
    }

    // The signed-in user's assigned block/wing ('' if none) — used to
    // scope a Warden's fee updates to their own block.
    function myBlock() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('block', '');
    }

    // Quantity sanity for inventory writes made by a Warden.
    function validInventory() {
      let d = request.resource.data;
      return d.get('quantity', 0) is number &&
             d.get('available', 0) is number &&
             d.get('damaged', 0) is number &&
             d.get('quantity', 0) >= 0 &&
             d.get('available', 0) >= 0 &&
             d.get('damaged', 0) >= 0 &&
             d.get('available', 0) + d.get('damaged', 0) <= d.get('quantity', 0);
    }

    function isAdmin() {
      return signedIn() && userRole() == "Admin";
    }

    function isWarden() {
      return signedIn() && userRole() == "Warden";
    }

    function isSecurity() {
      return signedIn() && userRole() == "Security";
    }

    function isStudent() {
      return signedIn() && userRole() == "Student";
    }

    function isParent() {
      return signedIn() && userRole() == "Parent";
    }

    // True for staff roles that legitimately need to see every student's
    // records (wardens/admins run the hostel; security needs gate-pass
    // lookups for anyone at the gate).
    function isStaff() {
      return isAdmin() || isWarden();
    }

    // A student may only read a record that is about *themselves*, and a
    // parent only a record about the one child their account is linked to.
    // This is the actual privacy boundary — everything else in this file is
    // either full staff access or this same check reused per collection.
    function isOwnRecord(studentId) {
      return (isStudent() && request.auth.uid == studentId) ||
             (isParent() && myLinkedStudentId() == studentId);
    }

    match /users/{userId} {
      // Users can read their own profile; staff can read anyone's (needed
      // for directories, room allotment, gate-pass lookups, etc.). A parent
      // is deliberately NOT given blanket read here — they only ever see
      // their linked child's profile via the /students/{studentId} document
      // below, never the full account list.
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || isWarden() || isSecurity());
      // Admin tooling creates/removes accounts outright. Updates are also
      // allowed for the signed-in user editing their OWN profile, but only
      // for the specific self-service fields every role's "Edit profile"
      // page actually exposes — role, email, hostelResidence and
      // linkedStudentId can never be touched this way, so a student/parent
      // can't self-escalate or relink to a different student.
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           "name", "dob", "phone", "bloodGroup", "address",
           "emergencyContactName", "emergencyContactPhone", "bio",
           "photoURL", "gateAssigned", "shift", "relationToStudent", "updatedAt"
         ]));
    }

    match /students/{studentId} {
      // Room/roommate/allocation record for one student. Staff see everyone;
      // the student sees their own; a linked parent sees only their child's.
      allow read: if isStaff() || isSecurity() || isOwnRecord(studentId);
      allow write: if isStaff();
    }

    match /fees/{feeId} {
      allow read: if isStaff() || isOwnRecord(resource.data.studentId);

      // Admin keeps full control of fee records (create/edit/delete).
      // A Warden can only UPDATE, only records in their own assigned
      // block (a warden with no block set manages all, matching the
      // Warden pages), only the payment/reminder fields, and paid can
      // only go up and never past the total. Wardens cannot create or
      // delete fee records. Student/parent privacy is unchanged (read).
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isWarden() &&
         (myBlock() == '' || resource.data.block == myBlock()) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['paid', 'status', 'lastPaymentAt', 'reminderSent', 'reminderSentAt',
                     'updatedBy', 'updatedByRole', 'updatedAt']) &&
         request.resource.data.get('paid', 0) >= resource.data.get('paid', 0) &&
         request.resource.data.get('paid', 0) <= request.resource.data.get('total', 0));
    }

    // Persistent messages from staff to ONE parent account (fee reminders and
    // leave decisions). A parent can read only notifications addressed to their
    // own uid; nobody else's. Staff create them only for a real Parent
    // account actually linked (users/{parent}.linkedStudentId) to the
    // student named in the message, with a deterministic id
    // (feeId_parentId_date, or leave_leaveId_parentId_status) so repeated sends can't stack duplicates.
    // Records are immutable after creation, with ONE exception: the parent a
    // notification is addressed to may flip it to read (read + readAt only).
    // Only Admin can delete.
    match /parentNotifications/{notificationId} {
      allow read: if isStaff() ||
        (isParent() && resource.data.parentId == request.auth.uid);
      allow create: if isStaff() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.read == false &&
        get(/databases/$(database)/documents/users/$(request.resource.data.parentId)).data.role == 'Parent' &&
        get(/databases/$(database)/documents/users/$(request.resource.data.parentId)).data.linkedStudentId == request.resource.data.studentId &&
        ((request.resource.data.type == 'Fee Reminder' &&
          notificationId == request.resource.data.feeId + '_' +
                            request.resource.data.parentId + '_' +
                            request.resource.data.date) ||
         (request.resource.data.type == 'Leave Update' &&
          notificationId == 'leave_' + request.resource.data.leaveId + '_' +
                            request.resource.data.parentId + '_' +
                            request.resource.data.leaveStatus));
      // Parent marks THEIR OWN notification as read. Nothing else may change:
      // only `read` (false -> true) and `readAt` (server time) are touched, so
      // parentId, studentId, title, message, amounts etc. stay immutable, and
      // a parent can't touch another parent's notification. Staff still can't
      // update (unchanged).
      allow update: if isParent() &&
        resource.data.parentId == request.auth.uid &&
        resource.data.get('read', false) == false &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']) &&
        request.resource.data.read == true &&
        request.resource.data.readAt == request.time;
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      // Warden and Security can both take attendance; every record they
      // write must carry their own uid as markedBy. New records use the id
      // studentId_date, so a student/date can only ever have one new record,
      // and an update can't move a record to another student or date.
      // Security has no delete. Admin is unrestricted (imports). Students
      // and parents read only their own / linked child's records.
      allow read: if isStaff() || isSecurity() || isOwnRecord(resource.data.studentId);
      allow create: if isAdmin() ||
        ((isWarden() || isSecurity()) &&
         request.resource.data.markedBy == request.auth.uid &&
         attendanceId == request.resource.data.studentId + '_' + request.resource.data.date);
      allow update: if isAdmin() ||
        ((isWarden() || isSecurity()) &&
         request.resource.data.markedBy == request.auth.uid &&
         request.resource.data.studentId == resource.data.studentId &&
         request.resource.data.date == resource.data.date);
      allow delete: if isStaff();
    }

    match /gatePasses/{gatePassId} {
      // Security needs to look up any student's pass at the gate, so it
      // keeps blanket read — everyone else is scoped to their own record.
      allow read: if isStaff() || isSecurity() || isOwnRecord(resource.data.studentId);
      allow create: if isStaff() || (isStudent() && request.auth.uid == request.resource.data.studentId);
      // Security may only log gate movement, and only these two transitions
      // (exactly what recordGateMovement() writes):
      //   OUT:    Approved pass with no trip yet   -> tripState 'Out'
      //           (status must stay 'Approved')
      //   RETURN: Approved pass currently 'Out'    -> tripState 'Returned'
      //           and status 'Completed'
      // Only tripState/status/updatedAt may change, so studentId, studentName,
      // from, to, type, reason and approval metadata are immutable for Security.
      // A Completed pass can never be re-opened, and Security can never
      // approve/reject a pass.
      allow update: if isStaff() ||
        (isSecurity() &&
         resource.data.status == 'Approved' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tripState', 'status', 'updatedAt']) &&
         ((!(resource.data.get('tripState', '') in ['Out', 'Returned']) &&
           request.resource.data.tripState == 'Out' &&
           request.resource.data.status == 'Approved') ||
          (resource.data.get('tripState', '') == 'Out' &&
           request.resource.data.tripState == 'Returned' &&
           request.resource.data.status == 'Completed')));
      allow delete: if isAdmin();
    }

    match /visitors/{visitorId} {
      allow read: if isStaff() || isSecurity() || isOwnRecord(resource.data.studentId);
      // Check-in / check-out. The register is a permanent history, so only
      // Admin/Warden can delete — Security cannot.
      allow create, update: if isStaff() || isSecurity();
      allow delete: if isStaff();
    }

    match /complaints/{complaintId} {
      allow read: if isStaff() || isOwnRecord(resource.data.studentId);
      allow create: if isStaff() || (isStudent() && request.auth.uid == request.resource.data.studentId);
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /inventory/{inventoryId} {
      // Actual hostel stock — staff only, never public. Admin keeps full
      // control (including the data-import path). A Warden can add and
      // update stock, but every write must keep quantities sane: numbers,
      // none negative, and available + damaged never above the total.
      // (Legacy imported rows without available/damaged still pass.)
      // Only Admin can delete a stock record.
      allow read: if isStaff();
      allow create, update: if isAdmin() || (isWarden() && validInventory());
      allow delete: if isAdmin();
    }

    match /notices/{noticeId} {
      // Notices are institution-wide, not per-student — no scoping needed
      // for signed-in users.
      //
      // Notices explicitly flagged `isPublic: true` are additionally
      // readable by anyone, signed in or not: that is what powers the
      // notice board on the public landing page. The flag is set by staff
      // through the admin "Show on the public website" checkbox, so an
      // internal notice is never exposed unless someone opts it in.
      allow read: if signedIn() || resource.data.isPublic == true;

      // Admin and Warden share this one collection. Admin keeps full
      // control. A Warden can publish/edit/delete notices but cannot use
      // them to reach the public website: a Warden-created notice must be
      // internal (isPublic false) and attributed to the Warden, and a
      // Warden edit cannot flip isPublic or relabel who created a notice.
      // Students, Security and Parents have no write access at all.
      allow create: if isAdmin() ||
        (isWarden() &&
         request.resource.data.get('isPublic', false) == false &&
         request.resource.data.get('createdByRole', '') == 'Warden');
      allow update: if isAdmin() ||
        (isWarden() &&
         request.resource.data.get('isPublic', false) == resource.data.get('isPublic', false) &&
         request.resource.data.get('createdByRole', '') == resource.data.get('createdByRole', ''));
      allow delete: if isStaff();
    }

    match /auditLogs/{auditLogId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /studentRegister/{regId} {
      // Institute-wide academic roster (registration no, branch, year) —
      // separate from hostel residency and portal login. Any signed-in
      // role can look a student up by registration number; only staff
      // can bulk-import or edit it. Deliberately keyed by registration
      // number, not Auth UID, since a register entry can exist for a
      // student long before — or entirely without — a portal account.
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /blocks/{blockId} {
      // Hostel block/wing config (capacity, assigned warden) — staff-managed.
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      // Renaming a block, changing its total bed count, or reassigning its
      // warden stays Admin-only. But allotting/vacating a bed is a Warden
      // action (RoomAllotment.jsx) that must keep occupiedBeds in sync, so
      // Warden gets a narrow exception for that one field only.
      allow update: if isAdmin() ||
        (isWarden() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["occupiedBeds"]));
    }

    match /leaveRequests/{leaveId} {
      // Security may read ONLY approved requests (to record physical exits)
      // — never Pending/Rejected — and has no write access at all, so it
      // can't approve, reject or otherwise change a leave request.
      allow read: if isStaff() || isOwnRecord(resource.data.studentId) ||
        (isSecurity() && resource.data.status == 'Approved');
      allow create: if isStaff() || (isStudent() && request.auth.uid == request.resource.data.studentId);
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Physical leave movements recorded by Security. Doc id == leaveRequestId
    // so a request can only ever have one log. Creation requires the leave
    // request to still be Approved and the log to be stamped with the
    // caller's uid and the real server time. Security's only update is the
    // Left -> Returned transition (status/returnedAt/returnedBy/returnedByUid).
    match /leaveLogs/{logId} {
      allow read: if isStaff() || isSecurity();
      allow create: if (isSecurity() || isStaff()) &&
        logId == request.resource.data.leaveRequestId &&
        request.resource.data.status == 'Left' &&
        request.resource.data.recordedByUid == request.auth.uid &&
        request.resource.data.leftAt == request.time &&
        get(/databases/$(database)/documents/leaveRequests/$(logId)).data.status == 'Approved';
      allow update: if (isSecurity() || isStaff()) &&
        resource.data.status == 'Left' &&
        request.resource.data.status == 'Returned' &&
        request.resource.data.returnedByUid == request.auth.uid &&
        request.resource.data.returnedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'returnedAt', 'returnedBy', 'returnedByUid']);
      allow delete: if isAdmin();
    }

    match /incidents/{incidentId} {
      allow read: if isStaff() || isSecurity();
      allow create, update: if isStaff() || isSecurity();
      allow delete: if isStaff();
    }

    match /sosAlerts/{alertId} {
      allow read: if isStaff() || isSecurity() || isOwnRecord(resource.data.studentId);
      allow create: if signedIn();
      allow update: if isStaff() || isSecurity();
      allow delete: if isAdmin();
    }

    match /emergencyContacts/{contactId} {
      // Read-only for Security and Parent; only Admin/Warden manage contacts.
      allow read: if isStaff() || isSecurity() || isParent();
      allow write: if isStaff();
    }

    match /feedback/{feedbackId} {
      allow read: if isStaff() || isOwnRecord(resource.data.studentId);
      allow create: if signedIn();
      allow update, delete: if isStaff();
    }

    match /dutyRoster/{rosterId} {
      allow read: if isStaff() || isSecurity();
      allow write: if isStaff();
    }

    match /gateLogs/{logId} {
      allow read: if isStaff() || isSecurity();
      allow create: if isSecurity() || isStaff();
      allow update, delete: if isAdmin();
    }

    match /messMenu/{menuId} {
      // Any signed-in user can read the timetable (students view/download
      // it); only Admin/Warden can change it. The menu is exactly one
      // document per weekday (doc id = weekday name), and meal fields, if
      // present, must be strings — so no stray documents or bad values.
      // Students, Parents and Security have no write access.
      allow read: if signedIn();
      allow create, update: if isStaff() &&
        menuId in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'] &&
        request.resource.data.get('breakfast', '') is string &&
        request.resource.data.get('lunch', '') is string &&
        request.resource.data.get('dinner', '') is string;
      allow delete: if isStaff();
    }

    match /messReports/{reportId} {
      allow read: if isStaff() || isOwnRecord(resource.data.studentId);
      allow create: if isStaff() || (isStudent() && request.auth.uid == request.resource.data.studentId);
      allow update, delete: if isStaff();
    }

    match /inventoryRequests/{requestId} {
      allow read: if isStaff() || isOwnRecord(resource.data.studentId);
      allow create: if isStaff() || (isStudent() && request.auth.uid == request.resource.data.studentId);
      allow update, delete: if isStaff();
    }

    match /roomRequests/{requestId} {
      allow read: if isStaff() || isOwnRecord(resource.data.studentId);
      allow create: if isStaff() || (isStudent() && request.auth.uid == request.resource.data.studentId);
      allow update, delete: if isStaff();
    }
  }
}
