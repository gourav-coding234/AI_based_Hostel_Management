rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function myLinkedStudentId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedStudentId;
    }

    function isAdmin() {
      return signedIn() && userRole() == "Admin";
    }

    function isWarden() {
      return signedIn() && userRole() == "Warden";
    }

    function isSecurity() {
      return signedIn() && userRole() == "Security";
    }

    function isStudent() {
      return signedIn() && userRole() == "Student";
    }

    function isParent() {
      return signedIn() && userRole() == "Parent";
    }

    // True for staff roles that legitimately need to see every student's
    // records (wardens/admins run the hostel; security needs gate-pass
    // lookups for anyone at the gate).
    function isStaff() {
      return isAdmin() || isWarden();
    }

    // A student may only read a record that is about *themselves*, and a
    // parent only a record about the one child their account is linked to.
    // This is the actual privacy boundary — everything else in this file is
    // either full staff access or this same check reused per collection.
    function isOwnRecord(studentId) {
      return (isStudent() && request.auth.uid == studentId) ||
             (isParent() && myLinkedStudentId() == studentId);
    }

    match /users/{userId} {
      // Users can read their own profile; staff can read anyone's (needed
      // for directories, room allotment, gate-pass lookups, etc.). A parent
      // is deliberately NOT given blanket read here — they only ever see
      // their linked child's profile via the /students/{studentId} document
      // below, never the full account list.
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || isWarden() || isSecurity());
      // Admin tooling creates/removes accounts outright. Updates are also
      // allowed for the signed-in user editing their OWN profile, but only
      // for the specific self-service fields every role's "Edit profile"
      // page actually exposes — role, email, hostelResidence and
      // linkedStudentId can never be touched this way, so a student/parent
      // can't self-escalate or relink to a different student.
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           "name", "dob", "phone", "bloodGroup", "address",
           "emergencyContactName", "emergencyContactPhone", "bio",
           "photoURL", "gateAssigned", "shift", "updatedAt"
         ]));
    }

    match /students/{studentId} {
      // Room/roommate/allocation record for one student. Staff see everyone;
      // the student sees their own; a linked parent sees only their child's.
      allow read: if isStaff() || isSecurity() || isOwnRecord(studentId);
      allow write: if isStaff();
    }

    match /fees/{feeId} {
      allow read: if isStaff() || isOwnRecord(resource.data.studentId);
      allow write: if isStaff();
    }

    match /attendance/{attendanceId} {
      allow read: if isStaff() || isOwnRecord(resource.data.studentId);
      allow write: if isStaff();
    }

    match /gatePasses/{gatePassId} {
      // Security needs to look up any student's pass at the gate, so it
      // keeps blanket read — everyone else is scoped to their own record.
      allow read: if isStaff() || isSecurity() || isOwnRecord(resource.data.studentId);
      allow create: if isStaff() || (isStudent() && request.auth.uid == request.resource.data.studentId);
      allow update: if isStaff() || isSecurity();
      allow delete: if isAdmin();
    }

    match /visitors/{visitorId} {
      allow read: if isStaff() || isSecurity() || isOwnRecord(resource.data.studentId);
      allow write: if isStaff() || isSecurity();
    }

    match /complaints/{complaintId} {
      allow read: if isStaff() || isOwnRecord(resource.data.studentId);
      allow create: if isStaff() || (isStudent() && request.auth.uid == request.resource.data.studentId);
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /inventory/{inventoryId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /notices/{noticeId} {
      // Notices are institution-wide, not per-student — no scoping needed.
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /auditLogs/{auditLogId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /blocks/{blockId} {
      // Hostel block/wing config (capacity, assigned warden) — staff-managed.
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      // Renaming a block, changing its total bed count, or reassigning its
      // warden stays Admin-only. But allotting/vacating a bed is a Warden
      // action (RoomAllotment.jsx) that must keep occupiedBeds in sync, so
      // Warden gets a narrow exception for that one field only.
      allow update: if isAdmin() ||
        (isWarden() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["occupiedBeds"]));
    }

    match /leaveRequests/{leaveId} {
      allow read: if isStaff() || isOwnRecord(resource.data.studentId);
      allow create: if isStaff() || (isStudent() && request.auth.uid == request.resource.data.studentId);
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /incidents/{incidentId} {
      allow read: if isStaff() || isSecurity();
      allow write: if isStaff() || isSecurity();
    }

    match /sosAlerts/{alertId} {
      allow read: if isStaff() || isSecurity() || isOwnRecord(resource.data.studentId);
      allow create: if signedIn();
      allow update: if isStaff() || isSecurity();
      allow delete: if isAdmin();
    }

    match /emergencyContacts/{contactId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /feedback/{feedbackId} {
      allow read: if isStaff() || isOwnRecord(resource.data.studentId);
      allow create: if signedIn();
      allow update, delete: if isStaff();
    }

    match /dutyRoster/{rosterId} {
      allow read: if isStaff() || isSecurity();
      allow write: if isStaff();
    }

    match /gateLogs/{logId} {
      allow read: if isStaff() || isSecurity();
      allow create: if isSecurity() || isStaff();
      allow update, delete: if isAdmin();
    }

    match /messMenu/{menuId} {
      allow read: if signedIn();
      allow write: if isStaff();
    }

    match /messReports/{reportId} {
      allow read: if isStaff() || isOwnRecord(resource.data.studentId);
      allow create: if isStaff() || (isStudent() && request.auth.uid == request.resource.data.studentId);
      allow update, delete: if isStaff();
    }

    match /inventoryRequests/{requestId} {
      allow read: if isStaff() || isOwnRecord(resource.data.studentId);
      allow create: if isStaff() || (isStudent() && request.auth.uid == request.resource.data.studentId);
      allow update, delete: if isStaff();
    }

    match /roomRequests/{requestId} {
      allow read: if isStaff() || isOwnRecord(resource.data.studentId);
      allow create: if isStaff() || (isStudent() && request.auth.uid == request.resource.data.studentId);
      allow update, delete: if isStaff();
    }
  }
}
