rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && userRole() == "Admin";
    }

    function isWarden() {
      return signedIn() && userRole() == "Warden";
    }

    function isSecurity() {
      return signedIn() && userRole() == "Security";
    }

    function isStudent() {
      return signedIn() && userRole() == "Student";
    }

    function isParent() {
      return signedIn() && userRole() == "Parent";
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin() || isWarden());
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isWarden();
      allow write: if isAdmin() || isWarden();
    }

    match /fees/{feeId} {
      allow read: if isAdmin() || isWarden() || isStudent() || isParent();
      allow write: if isAdmin() || isWarden();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || isWarden() || isStudent() || isParent();
      allow write: if isAdmin() || isWarden();
    }

    match /gatePasses/{gatePassId} {
      allow read: if isAdmin() || isWarden() || isSecurity() || isStudent() || isParent();
      allow create: if isAdmin() || isWarden() || isStudent();
      allow update: if isAdmin() || isWarden() || isSecurity();
      allow delete: if isAdmin();
    }

    match /visitors/{visitorId} {
      allow read: if isAdmin() || isWarden() || isSecurity() || isStudent() || isParent();
      allow write: if isAdmin() || isWarden() || isSecurity();
    }

    match /complaints/{complaintId} {
      allow read: if isAdmin() || isWarden() || isStudent() || isParent();
      allow create: if isAdmin() || isWarden() || isStudent();
      allow update: if isAdmin() || isWarden();
      allow delete: if isAdmin();
    }

    match /inventory/{inventoryId} {
      allow read: if isAdmin() || isWarden();
      allow write: if isAdmin() || isWarden();
    }

    match /notices/{noticeId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isWarden();
    }

    match /auditLogs/{auditLogId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }
  }
}
