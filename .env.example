# ---------------------------------------------------------------------------
# Firebase configuration
# ---------------------------------------------------------------------------
# 1. Copy this file to `.env` in the same folder (app/.env)
# 2. Fill in the values from your Firebase project:
#      Firebase console -> Project settings -> General
#      -> "Your apps" -> Web app -> SDK setup and configuration -> Config
# 3. Restart the dev server (Vite only reads .env files at startup)
#
# These VITE_ values are bundled into the client build. That is expected and
# safe for Firebase web apps: they identify the project, they do not grant
# access. Actual access control is enforced by firestore.rules.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
# Optional. Profile photos no longer depend on Firebase Storage.
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# ---------------------------------------------------------------------------
# Server-only credentials for Admin > Manage Users account editing
# ---------------------------------------------------------------------------
# Set these in Vercel Project Settings > Environment Variables (and locally
# for Vercel Functions). Create a service account in Firebase Console >
# Project settings > Service accounts. Never prefix these with VITE_ and
# never expose the private key in browser code.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
