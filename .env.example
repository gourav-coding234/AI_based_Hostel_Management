# ---------------------------------------------------------------------------
# Firebase configuration
# ---------------------------------------------------------------------------
# 1. Copy this file to `.env` in the same folder (app/.env)
# 2. Fill in the values from your Firebase project:
#      Firebase console -> Project settings -> General
#      -> "Your apps" -> Web app -> SDK setup and configuration -> Config
# 3. Restart the dev server (Vite only reads .env files at startup)
#
# These VITE_ values are bundled into the client build. That is expected and
# safe for Firebase web apps: they identify the project, they do not grant
# access. Actual access control is enforced by firestore.rules.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
